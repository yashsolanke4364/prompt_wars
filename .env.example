# ==============================================================================
# ScholarshipSaathi AI - Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Kept strictly server-side; NEVER expose to client)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime environment
NODE_ENV=development

# Optional Firebase config (Local demo localStorage active by default)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
